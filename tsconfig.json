{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "types": ["node", "obsidian", "jest"],
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "obsidian": ["./src/__mocks__/obsidian.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "__mocks__/**/*"],
  "exclude": ["node_modules"]
}
